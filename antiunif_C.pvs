%%%% Proofs for the termination measure of antiunifyC (ProofLite)

%|- sizes_ms_TCC1 : PROOF
%|- (then (skosimp*) (use "empty_msT_is_finite"))
%|- QED

%|- sizes_ms_TCC3 : PROOF
%|- (then (skosimp*) (typepred "v!1(cdr[(validConfiguration?)](lc!1))") (use
%|-       "union_msT_fin_msT_is_fin_msT" ("m"
%|-       "singleton_msT(size(car[(validConfiguration?)](lc!1)`unsolved))" "n"
%|-       "v!1(cdr[(validConfiguration?)](lc!1))")))
%|- QED

%|- msT_gt_replace_TCC1 : PROOF
%|- (then (skosimp*) (use "union_msT_fin_msT_is_fin_msT" ("m"
%|-       "singleton_msT(a!1)" "n" "M!1")))
%|- QED

%|- msT_gt_replace_TCC2 : PROOF
%|- (then (skosimp*) (use "union_msT_fin_msT_is_fin_msT" ("m" "Y!1" "n" "M!1")))
%|- QED

%|- conv_ms_ord_well_founded : PROOF
%|- (then (lemma "msT_gt_well_founded") (expand "converse" -1) (expand "conv_ms_ord")
%|-       (propax))
%|- QED

%|- antiunifyC_TCC1 : PROOF
%|- (then (lemma "conv_ms_ord_well_founded") (expand "conv_ms_ord") (grind))
%|- QED

%|- msT_gt_replace : PROOF
%|- (then (skeep) (expand "msT_gt?") (inst + "singleton_msT(a)" "Y") (spread
%|-       (split 1) ((grind) (then (flatten) (decompose-equality -1) (inst -1
%|-       "a") (grind)) (then (apply-extensionality :hide? t) (grind)) (then
%|-       (skeep) (inst + "a") (inst -1 "y") (grind)))))
%|- QED

%|- conv_ms_ord_replace_car : PROOF
%|- (then (skeep) (label "e" -1) (typepred "l1") (typepred "l2") (expand
%|-       "conv_ms_ord") (expand "sizes_ms" 1) (assert) (replace "e") (use
%|-       "msT_gt_replace" ("M" "sizes_ms(cdr(l2))" "Y"
%|-       "singleton_msT(size(car(l1)`unsolved))" "a" "size(car(l2)`unsolved)"))
%|-       (split -1) (propax) (grind))
%|- QED

%|- conv_ms_ord_replace_car2 : PROOF
%|- (then (skeep) (label "e" -1) (typepred "l1") (typepred "l2") (expand
%|-       "conv_ms_ord") (expand "sizes_ms" 1) (assert) (expand "sizes_ms" 1 2)
%|-       (assert) (replace "e") (rewrite "union_msT_assoc") (spread (use
%|-       "msT_gt_replace" ("M" "sizes_ms(cdr(l2))" "Y"
%|-       "union_msT(singleton_msT(size(car(l1)`unsolved)), singleton_msT(size(car(cdr(l1))`unsolved)))"
%|-       "a" "size(car(l2)`unsolved)")) ((then (split -1) (propax) (grind))
%|-       (use "union_msT_fin_msT_is_fin_msT"))))
%|- QED

%|- conv_ms_ord_remove_car : PROOF
%|- (then (skeep) (typepred "l") (expand "conv_ms_ord") (expand "sizes_ms" 1 1)
%|-       (assert) (spread (use "msT_gt_replace" ("M" "sizes_ms(cdr(l))" "Y"
%|-       "empty_msT" "a" "size(car(l)`unsolved)")) ((then (rewrite
%|-       "union_msT_empty_msT_left" -1) (split -1) (propax) (grind)) (use
%|-       "empty_msT_is_finite"))))
%|- QED

%|- antiunifyC_TCC3 : PROOF
%|- (then (skosimp*) (replace*) (typepred "DecCmmF(plc!1)") (beta) (flatten)
%|-       (expand "size") (use "conv_ms_ord_replace_car2" ("l1" "DecCmmF(plc!1)`1"
%|-       "l2" "plc!1`1")) (assert))
%|- QED

%|- antiunifyC_TCC5 : PROOF
%|- (then (skosimp*) (replace*) (typepred "DecF(plc!1)") (beta) (flatten)
%|-       (expand "size") (use "conv_ms_ord_replace_car" ("l1" "DecF(plc!1)`1" "l2"
%|-       "plc!1`1")) (assert))
%|- QED

%|- antiunifyC_TCC7 : PROOF
%|- (then (skosimp*) (replace*) (typepred "DecP(plc!1)") (beta) (flatten)
%|-       (expand "size") (use "conv_ms_ord_replace_car" ("l1" "DecP(plc!1)`1" "l2"
%|-       "plc!1`1")) (assert))
%|- QED

%|- antiunifyC_TCC8 : PROOF
%|- (then (skosimp*) (typepred "cp!1") (replace*) (expand "size") (use
%|-       "conv_ms_ord_replace_car" ("l1" "cons(Synt(car(plc!1`1)), cdr(plc!1`1))"
%|-       "l2" "plc!1`1")) (assert))
%|- QED

%|- antiunifyC_TCC10 : PROOF
%|- (then (skosimp*) (typepred "cp!1") (replace*) (expand "size") (use
%|-       "conv_ms_ord_replace_car" ("l1" "cons(Solve(car(plc!1`1)), cdr(plc!1`1))"
%|-       "l2" "plc!1`1")) (assert))
%|- QED

%|- antiunifyC_TCC12 : PROOF
%|- (then (skosimp*) (replace*) (expand "size") (use "conv_ms_ord_remove_car" ("l"
%|-       "plc!1`1")) (assert))
%|- QED

%%%% Proofs by induction on the termination measure (ProofLite)

%|- antiunify_final_nonempty : PROOF
%|- (spread (measure-induct+ "size(plc)" ("plc") :order "conv_ms_ord") ((then (label
%|-       "ih" -1) (spread (case "cons?(x!1`1)") ((spread (case
%|-       "cons?(car(x!1`1)`unsolved)") ((spread (case
%|-       "match_DecCmmF_conf?(car(x!1`1))") ((then (expand "antiunifyC" +)
%|-       (assert) (typepred "DecCmmF(x!1)") (beta) (flatten) (inst "ih"
%|-       "DecCmmF(x!1)") (assert) (expand "size") (use "conv_ms_ord_replace_car2"
%|-       ("l1" "DecCmmF(x!1)`1" "l2" "x!1`1")) (assert)) (spread (case
%|-       "match_DecF_conf?(car(x!1`1))") ((then (expand "antiunifyC" +) (assert)
%|-       (typepred "DecF(x!1)") (beta) (flatten) (inst "ih" "DecF(x!1)")
%|-       (assert) (expand "size") (use "conv_ms_ord_replace_car" ("l1" "DecF(x!1)`1"
%|-       "l2" "x!1`1")) (assert)) (spread (case "match_DecP_conf?(car(x!1`1))")
%|-       ((then (expand "antiunifyC" +) (assert) (typepred "DecP(x!1)") (beta)
%|-       (flatten) (inst "ih" "DecP(x!1)") (assert) (expand "size") (use
%|-       "conv_ms_ord_replace_car" ("l1" "DecP(x!1)`1" "l2" "x!1`1")) (assert))
%|-       (spread (case "match_Synt_conf?(car(x!1`1))") ((then (expand
%|-       "antiunifyC" +) (assert) (typepred "Synt(car(x!1`1))") (inst "ih"
%|-       "(cons(Synt(car(x!1`1)), cdr(x!1`1)), x!1`2)") (assert) (expand
%|-       "size") (use "conv_ms_ord_replace_car" ("l1"
%|-       "cons(Synt(car(x!1`1)), cdr(x!1`1))" "l2" "x!1`1")) (assert)) (then
%|-       (expand "antiunifyC" +) (assert) (typepred "Solve(car(x!1`1))") (inst
%|-       "ih" "(cons(Solve(car(x!1`1)), cdr(x!1`1)), x!1`2)") (assert) (expand
%|-       "size") (use "conv_ms_ord_replace_car" ("l1"
%|-       "cons(Solve(car(x!1`1)), cdr(x!1`1))" "l2" "x!1`1")) (assert))))))))))
%|-       (then (expand "antiunifyC" +) (assert) (inst "ih"
%|-       "(cdr(x!1`1), cons(car(x!1`1), x!1`2))") (assert) (expand "size") (use
%|-       "conv_ms_ord_remove_car" ("l" "x!1`1")) (assert)))) (then (expand
%|-       "antiunifyC" +) (assert) (flatten) (assert))))) (use
%|-       "conv_ms_ord_well_founded")))
%|- QED

%|- antiunify_monotony_Sol_AUTs_TCC1 : PROOF
%|- (then (skosimp* :preds? t) (use "antiunify_final_nonempty") (assert))
%|- QED

%|- antiunify_domain_disjoint_sol_labels_TCC1 : PROOF
%|- (then (skosimp* :preds? t) (use "antiunify_final_nonempty") (assert))
%|- QED

%|- antiunify_normality : PROOF
%|- (then (skosimp* :preds? t) (expand "normal_plc?") (expand "antiunifyC")
%|-       (assert))
%|- QED

end antiunif_C

