    (|sub| TYPE-EQ-DECL NIL |first_order_substitution| NIL)
    (|C_symbol| FORMAL-CONST-DECL "PRED[f_symbol]" |first_order_C_substitution|
     NIL)
    (|C_sub?| CONST-DECL "bool" |first_order_C_terms| NIL)
    (|C_sub| NONEMPTY-TYPE-EQ-DECL NIL |first_order_C_terms| NIL)
    (|append| DEF-DECL "list[T]" |list_props| NIL)
    (|equal_implies_eq_C_sub| FORMULA-DECL NIL |first_order_C_substitution|
     NIL))
   SHOSTAK)))

