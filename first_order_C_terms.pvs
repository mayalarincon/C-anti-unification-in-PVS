%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%  First-order terms with commutative symbols (Antiunify th) %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Conservative extension of first_order_terms and first_order_substitution:
% neither theory (nor the datatype first_order_term) is modified.
%
% Given a class C_symbol of commutative function symbols, a C-term is a
% first-order term in which every application of a commutative symbol has
% a pair as argument. C-terms (C_term) and C-substitutions (C_sub) are
% predicate subtypes of first_order_term and sub, hence every definition and
% lemma of the imported theories applies to them without change; the
% judgements below guarantee that the term constructors, accessors,
% substitution application and composition stay inside the subtypes.
%
% NOTE: no ASSUMPTION is placed on C_symbol. An assumption such as
%    FORALL (t: (app?)): C_symbol(f_sym(t)) IMPLIES pair?(arg(t))
% is unsatisfiable as soon as C_symbol is nonempty (take app(f, unit)),
% so the restriction is expressed by the predicate C_term? instead.
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

first_order_C_terms[(IMPORTING first_order_substitution)
                    C_symbol: PRED[f_symbol]]: THEORY
BEGIN

a: VAR constant
X: VAR variable
f: VAR f_symbol
t, t1, t2, s: VAR first_order_term
sigma, delta: VAR sub
b: VAR basic_sub

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%  C-terms  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% every commutative symbol occurring in t is applied to a pair
C_term?(t): RECURSIVE bool =
    CASES t OF
       const(a): TRUE,
       variable(X): TRUE,
       unit: TRUE,
       pair(t1, t2): C_term?(t1) AND C_term?(t2),
       app(f, arg): C_term?(arg) AND (C_symbol(f) IMPLIES pair?(arg))
    ENDCASES
MEASURE t BY <<

% unfolding of C_term? in terms of recognizers and accessors
C_term_unfold: LEMMA
    C_term?(t) =
      ((pair?(t) IMPLIES C_term?(term1(t)) AND C_term?(term2(t))) AND
       (app?(t) IMPLIES C_term?(arg(t)) AND (C_symbol(f_sym(t)) IMPLIES pair?(arg(t)))))
%|- C_term_unfold : PROOF
%|- (then (skeep) (expand "C_term?" 1 1) (lift-if) (ground))
%|- QED

C_term: TYPE+ = (C_term?) CONTAINING unit
%|- C_term_TCC1 : PROOF
%|- (grind)
%|- QED

ct, ct1, ct2: VAR C_term

% closure of C-terms under the constructors
const_is_C_term: JUDGEMENT const(a) HAS_TYPE C_term
%|- const_is_C_term : PROOF
%|- (grind)
%|- QED

var_is_C_term: JUDGEMENT variable(X) HAS_TYPE C_term
%|- var_is_C_term : PROOF
%|- (grind)
%|- QED

unit_is_C_term: JUDGEMENT unit HAS_TYPE C_term
%|- unit_is_C_term : PROOF
%|- (grind)
%|- QED

pair_is_C_term: JUDGEMENT pair(ct1, ct2) HAS_TYPE C_term
%|- pair_is_C_term : PROOF
%|- (then (skosimp* :preds? t) (grind))
%|- QED

app_non_C_is_C_term: JUDGEMENT
    app(f: {f | NOT C_symbol(f)}, ct) HAS_TYPE C_term
%|- app_non_C_is_C_term : PROOF
%|- (then (skosimp* :preds? t) (grind))
%|- QED

C_term_app_C: LEMMA
    C_symbol(f) IMPLIES C_term?(app(f, pair(ct1, ct2)))
%|- C_term_app_C : PROOF
%|- (then (skosimp* :preds? t) (grind))
%|- QED

% closure of C-terms under the accessors
term1_C_term: JUDGEMENT term1(ct: {ct | pair?(ct)}) HAS_TYPE C_term
%|- term1_C_term : PROOF
%|- (then (skosimp* :preds? t) (lemma "C_term_unfold") (inst - "ct!1") (ground))
%|- QED

term2_C_term: JUDGEMENT term2(ct: {ct | pair?(ct)}) HAS_TYPE C_term
%|- term2_C_term : PROOF
%|- (then (skosimp* :preds? t) (lemma "C_term_unfold") (inst - "ct!1") (ground))
%|- QED

arg_C_term: JUDGEMENT arg(ct: {ct | app?(ct)}) HAS_TYPE C_term
%|- arg_C_term : PROOF
%|- (then (skosimp* :preds? t) (lemma "C_term_unfold") (inst - "ct!1") (ground))
%|- QED

% commutative symbols in C-terms are applied to pairs
C_term_app_C_pair: LEMMA
    app?(ct) AND C_symbol(f_sym(ct)) IMPLIES pair?(arg(ct))
%|- C_term_app_C_pair : PROOF
%|- (then (skosimp* :preds? t) (lemma "C_term_unfold") (inst - "ct!1") (ground))
%|- QED

C_term_app_iff: LEMMA
    C_term?(app(f, t)) IFF (C_term?(t) AND (C_symbol(f) IMPLIES pair?(t)))
%|- C_term_app_iff : PROOF
%|- (grind)
%|- QED

C_term_pair_iff: LEMMA
    C_term?(pair(t1, t2)) IFF (C_term?(t1) AND C_term?(t2))
%|- C_term_pair_iff : PROOF
%|- (grind)
%|- QED

% without commutative symbols every first-order term is a C-term
C_term_no_C_symbols: LEMMA
    (FORALL f: NOT C_symbol(f)) IMPLIES C_term?(t)
%|- C_term_no_C_symbols : PROOF
%|- (then (induct "t") (grind))
%|- QED

% subterms of C-terms are C-terms
C_term_subterms: LEMMA
    C_term?(t) AND member(s, subterms(t)) IMPLIES C_term?(s)
%|- C_term_subterms : PROOF
%|- (spread (induct "t")
%|-  ((grind) (grind) (grind)
%|-   (then (skosimp*) (inst - "s!1") (inst - "s!1") (grind))
%|-   (then (skosimp*) (inst - "s!1") (grind))))
%|- QED

% swapping the arguments of a commutative application
C_swap(ct: {ct | app?(ct) AND C_symbol(f_sym(ct))}): C_term =
    app(f_sym(ct), pair(term2(arg(ct)), term1(arg(ct))))
%|- C_swap_TCC1 : PROOF
%|- (grind)
%|- QED
%|- C_swap_TCC2 : PROOF
%|- (then (skosimp* :preds? t) (use "C_term_app_C_pair") (assert)
%|-       (lemma "C_term_unfold") (inst-cp - "ct!1") (inst - "arg(ct!1)") (iff) (ground)
%|-       (use "C_term_app_C" ("f" "f_sym(ct!1)" "ct1" "term2(arg(ct!1))" "ct2" "term1(arg(ct!1))"))
%|-       (assert))
%|- QED

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%  C-substitutions  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% a C-substitution maps every variable to a C-term
C_sub?(sigma): bool = FORALL X: C_term?(subs(sigma)(X))

C_sub: TYPE+ = (C_sub?) CONTAINING null[basic_sub]
%|- C_sub_TCC1 : PROOF
%|- (grind)
%|- QED

csigma, cdelta: VAR C_sub

% equivalently, the image of sigma consists of C-terms
C_sub_img: LEMMA
    C_sub?(sigma) IFF (FORALL t: member(t, img(sigma)) IMPLIES C_term?(t))
%|- C_sub_img : PROOF
%|- (then (skeep) (expand "C_sub?") (expand "img") (expand "dom") (grind))
%|- QED

C_sub_basic: LEMMA
    C_term?(t) AND C_term?(s) IMPLIES C_term?(subs((X, t), s))
%|- C_sub_basic : PROOF
%|- (then (induct "s") (grind))
%|- QED

C_sub_cons: LEMMA
    C_term?(t) AND C_sub?(sigma) IMPLIES C_sub?(cons((X, t), sigma))
%|- C_sub_cons : PROOF
%|- (then (skeep) (expand "C_sub?") (skolem 1 "Y") (inst - "Y")
%|-       (expand "subs" 1) (expand "subs" 1) (expand "subs" -2)
%|-       (use "C_sub_basic") (assert))
%|- QED

% a sufficient syntactic criterion: every binding has a C-term as image
C_sub_every: LEMMA
    every(LAMBDA b: C_term?(b`2))(sigma) IMPLIES C_sub?(sigma)
%|- C_sub_every : PROOF
%|- (spread (induct "sigma")
%|-  ((grind)
%|-   (then (skosimp) (expand "every" -2) (flatten) (assert) (use "C_sub_cons")
%|-         (inst - "cons1_var!1`1") (assert)
%|-         (case-replace "(cons1_var!1`1, cons1_var!1`2) = cons1_var!1") (assert)
%|-         (apply-extensionality))))
%|- QED

subs_pair_preserved: LEMMA
    pair?(t) IMPLIES pair?(subs(sigma)(t))
%|- subs_pair_preserved : PROOF
%|- (then (skeep) (lemma "subs_pair" ("sigma" "sigma" "t" "term1(t)" "s" "term2(t)"))
%|-       (spread (case-replace "pair(term1(t), term2(t)) = t")
%|-               ((then (replace -2) (assert)) (apply-extensionality))))
%|- QED

% applying a C-substitution to a C-term yields a C-term
subs_C_term: LEMMA
    C_sub?(sigma) AND C_term?(t) IMPLIES C_term?(subs(sigma)(t))
%|- subs_C_term : PROOF
%|- (spread (induct "t")
%|-  ((then (skosimp*) (rewrite "subs_const") (grind))
%|-   (grind)
%|-   (then (skosimp*) (rewrite "subs_unit") (grind))
%|-   (then (skosimp*) (rewrite "subs_pair") (grind))
%|-   (then (skosimp*) (rewrite "subs_app") (use "subs_pair_preserved") (grind))))
%|- QED

subs_is_C_term: JUDGEMENT subs(csigma)(ct) HAS_TYPE C_term
%|- subs_is_C_term : PROOF
%|- (then (skosimp* :preds? t) (use "subs_C_term") (assert))
%|- QED

% composition of C-substitutions is a C-substitution
append_C_sub: LEMMA
    C_sub?(sigma) AND C_sub?(delta) IMPLIES C_sub?(append(sigma, delta))
%|- append_C_sub : PROOF
%|- (then (skeep) (expand "C_sub?" 1) (skolem 1 "Y") (expand "subs" 1)
%|-       (rewrite "subs_append2") (use "subs_C_term") (assert)
%|-       (expand "C_sub?" -) (inst - "Y") (grind))
%|- QED

append_is_C_sub: JUDGEMENT append(csigma, cdelta) HAS_TYPE C_sub
%|- append_is_C_sub : PROOF
%|- (then (skosimp* :preds? t) (use "append_C_sub") (assert))
%|- QED

% renamings are C-substitutions
renaming_is_C_sub: JUDGEMENT renaming SUBTYPE_OF C_sub
%|- renaming_is_C_sub : PROOF
%|- (then (skosimp* :preds? t) (rewrite "C_sub_img") (expand "renaming?") (skeep)
%|-       (inst - "t") (grind))
%|- QED

% C_sub? is invariant under extensional equality of substitutions
equal_C_sub: LEMMA
    equal?(sigma, delta) AND C_sub?(sigma) IMPLIES C_sub?(delta)
%|- equal_C_sub : PROOF
%|- (then (skeep) (expand "C_sub?") (expand "equal?") (skolem 1 "Y")
%|-       (inst - "Y") (inst - "Y") (assert))
%|- QED

END first_order_C_terms
